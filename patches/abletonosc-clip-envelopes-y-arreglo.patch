+        #--------------------------------------------------------------------------------
+        # Clip: automation envelopes.
+        #
+        # Live exposes Clip.automation_envelope(parameter) and
+        # create_automation_envelope(parameter) on SESSION clips only; an arrangement clip
+        # returns None. Every handler here reports that plainly instead of throwing, so the
+        # caller can tell "not supported here" from "it failed".
+        #
+        # A whole sweep goes in ONE message. Writing 128 breakpoints as 128 OSC round trips
+        # is slow enough to be unusable, and every round trip is another chance to catch
+        # Live busy.
+        #
+        # Args after the clip's own (track, scene): the device is addressed explicitly by
+        # its own track, so a clip can automate a parameter on any track, not just its own.
+        #   set:   <track> <scene> <device_track> <device> <param> [time dur value]*N
+        #   get:   <track> <scene> <device_track> <device> <param> <time>
+        #   clear: <track> <scene> <device_track> <device> <param>
+        #--------------------------------------------------------------------------------
+        def _envelope_for(clip, params, create=False):
+            try:
+                device_track, device_index, parameter_index = (
+                    int(params[2]), int(params[3]), int(params[4]))
+            except (IndexError, ValueError, TypeError):
+                return None, "expected device_track, device, parameter"
+            try:
+                parameter = self.song.tracks[device_track].devices[device_index].parameters[parameter_index]
+            except (IndexError, AttributeError):
+                return None, "no such device or parameter"
+            envelope = clip.automation_envelope(parameter)
+            if envelope is None and create:
+                try:
+                    envelope = clip.create_automation_envelope(parameter)
+                except Exception as e:
+                    return None, "cannot create envelope: %s" % e
+            if envelope is None:
+                return None, "no envelope (arrangement clips cannot have one)"
+            return envelope, None
+
+        def clip_get_envelope_value(clip, params: Tuple[Any]):
+            envelope, problem = _envelope_for(clip, params)
+            if envelope is None:
+                return ("unsupported", problem)
+            try:
+                time = float(params[5])
+            except (IndexError, ValueError):
+                return ("error", "expected a time in beats")
+            return (envelope.value_at_time(time),)
+
+        def clip_set_envelope(clip, params: Tuple[Any]):
+            steps = params[5:]
+            if not steps or len(steps) % 3 != 0:
+                return ("error", "expected triples of time, duration, value")
+            envelope, problem = _envelope_for(clip, params, create=True)
+            if envelope is None:
+                return ("unsupported", problem)
+            written = 0
+            for index in range(0, len(steps), 3):
+                try:
+                    envelope.insert_step(float(steps[index]), float(steps[index + 1]),
+                                         float(steps[index + 2]))
+                    written += 1
+                except Exception as e:
+                    self.logger.warning("clip envelope: insert_step failed: %s" % e)
+                    return ("error", str(e), written)
+            return (written,)
+
+        def clip_clear_envelope(clip, params: Tuple[Any]):
+            envelope, problem = _envelope_for(clip, params)
+            if envelope is None:
+                return ("unsupported", problem)
+            envelope.clear()
+            return ("cleared",)
+
+        self.osc_server.add_handler("/live/clip/get/envelope_value",
+                                    create_clip_callback(clip_get_envelope_value, pass_clip_index=True))
+        self.osc_server.add_handler("/live/clip/set/envelope",
+                                    create_clip_callback(clip_set_envelope, pass_clip_index=True))
+        self.osc_server.add_handler("/live/clip/clear/envelope",
+                                    create_clip_callback(clip_clear_envelope, pass_clip_index=True))
