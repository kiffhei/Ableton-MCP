+        def _search_browser(root_items, query, results, max_results=30):
+            """Recursive browser search. Returns list of (name, uri, is_folder)."""
+            if len(results) >= max_results:
+                return
+            for item in root_items:
+                if len(results) >= max_results:
+                    return
+                try:
+                    name = item.name or ""
+                    uri = item.uri if hasattr(item, 'uri') else ""
+                    is_folder = item.is_folder if hasattr(item, 'is_folder') else False
+                    is_loadable = item.is_loadable if hasattr(item, 'is_loadable') else False
+                    if query in name.lower():
+                        results.append((name, uri, is_folder, is_loadable))
+                    if is_folder:
+                        try:
+                            _search_browser(item.children, query, results, max_results)
+                        except Exception:
+                            pass
+                except Exception:
+                    pass
+
+        def _find_item_by_name(root_items, name_lower, categories=None, depth=0):
+            """Exact name match, searching given category roots."""
+            if depth > 4:
+                return None
+            for item in root_items:
+                try:
+                    if item.name.lower() == name_lower:
+                        return item
+                    if item.is_folder and depth < 4:
+                        found = _find_item_by_name(item.children, name_lower, depth=depth+1)
+                        if found is not None:
+                            return found
+                except Exception:
+                    pass
+            return None
+
+        def _collect_matches(root_items, query_lower, out, depth=0):
+            """Every loadable item whose name contains the query."""
+            if depth > 4:
+                return
+            for item in root_items:
+                try:
+                    is_loadable = item.is_loadable if hasattr(item, 'is_loadable') else False
+                    if is_loadable and query_lower in item.name.lower():
+                        out.append(item)
+                    if item.is_folder and depth < 4:
+                        _collect_matches(item.children, query_lower, out, depth=depth+1)
+                except Exception:
+                    pass
+
+        def _find_item_containing(root_items, query_lower, depth=0):
+            """Best loadable match: exact name first, then shortest name.
+
+            Taking the first substring hit loads the wrong thing whenever a plugin
+            name contains a native device name -- asking for "Compressor" used to
+            load the AU "AUMultibandCompressor". Preferring an exact match, and
+            otherwise the shortest name, picks the plain device.
+            """
+            matches = []
+            _collect_matches(root_items, query_lower, matches, depth)
+            if not matches:
+                return None
+            for item in matches:
+                if item.name.lower() == query_lower:
+                    return item
+            return min(matches, key=lambda item: len(item.name))
