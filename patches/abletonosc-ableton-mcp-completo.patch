+        #--------------------------------------------------------------------------------
+        # Device: Sidechain (audio input) routing.
+        # Only Live.CompressorDevice exposes this (Live 11+); it mirrors the Track
+        # routing API. Glue Compressor and Gate do NOT have it, so every handler here
+        # reports plainly when the device lacks the attribute instead of raising.
+        #--------------------------------------------------------------------------------
+        def _has_routing(device):
+            return hasattr(device, "available_input_routing_types")
+
+        def device_get_available_input_routing_types(device, params: Tuple[Any] = ()):
+            if not _has_routing(device):
+                return ("unsupported",)
+            return tuple(t.display_name for t in device.available_input_routing_types)
+
+        def device_get_available_input_routing_channels(device, params: Tuple[Any] = ()):
+            if not _has_routing(device):
+                return ("unsupported",)
+            return tuple(c.display_name for c in device.available_input_routing_channels)
+
+        def device_get_input_routing_type(device, params: Tuple[Any] = ()):
+            if not _has_routing(device):
+                return ("unsupported",)
+            return (device.input_routing_type.display_name,)
+
+        def device_set_input_routing_type(device, params: Tuple[Any] = ()):
+            if not _has_routing(device):
+                self.logger.warning("device sidechain: %s has no input routing" % device.name)
+                return
+            wanted = str(params[0])
+            for routing_type in device.available_input_routing_types:
+                if routing_type.display_name == wanted:
+                    device.input_routing_type = routing_type
+                    return
+            self.logger.warning("Couldn't find device input routing type: %s" % wanted)
+
+        def device_get_input_routing_channel(device, params: Tuple[Any] = ()):
