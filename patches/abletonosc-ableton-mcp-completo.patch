+        #--------------------------------------------------------------------------------
+        # Track: delete a device by index. The Live API has delete_device on the track;
+        # AbletonOSC exposed delete_clip and delete_track but never this one, which left
+        # a wrongly loaded device impossible to remove without touching the mouse.
+        #--------------------------------------------------------------------------------
+        def track_delete_device(track, params: Tuple[Any]):
+            device_index = int(params[0])
+            if not 0 <= device_index < len(track.devices):
+                self.logger.warning("delete_device: index %d out of range on '%s'"
+                                    % (device_index, track.name))
+                return
+            name = track.devices[device_index].name
+            track.delete_device(device_index)
