+        #--------------------------------------------------------------------------------
+        # Track: move a session clip into the Arrangement.
+        #
+        # AbletonOSC could READ arrangement clips (names, lengths, start times) but had no
+        # way to PUT one there, so a set built by OSC could never leave the session grid.
+        # Live's API has Track.duplicate_clip_to_arrangement(clip, time); this exposes it.
+        # Times are in beats from the start of the song.
+        #--------------------------------------------------------------------------------
+        def track_duplicate_clip_to_arrangement(track, params: Tuple[Any]):
+            scene_index, destination = int(params[0]), float(params[1])
+            if not hasattr(track, "duplicate_clip_to_arrangement"):
+                self.logger.warning("duplicate_clip_to_arrangement: not available in this Live version")
+                return ("unsupported",)
+            try:
+                clip = track.clip_slots[scene_index].clip
+            except IndexError:
+                return ("error", "no such scene")
+            if clip is None:
+                return ("error", "empty clip slot")
+            try:
+                track.duplicate_clip_to_arrangement(clip, destination)
+            except Exception as e:
+                self.logger.warning("duplicate_clip_to_arrangement failed: %s" % e)
+                return ("error", str(e))
+            return (len(track.arrangement_clips),)
+
+        def track_delete_arrangement_clip(track, params: Tuple[Any]):
+            index = int(params[0])
+            clips = list(track.arrangement_clips)
+            if not 0 <= index < len(clips):
+                return ("error", "index out of range")
+            try:
+                track.delete_clip(clips[index])
+            except Exception as e:
+                return ("error", str(e))
+            return (len(track.arrangement_clips),)
